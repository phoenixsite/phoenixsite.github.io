---
import Base from '../../../layouts/Base.astro';
import { getPosts, postSlug } from '../../../lib/posts';

const posts = await getPosts('en');
---

<Base title="Blog" lang="en" altPath="/blog/">
  <h1>Blog</h1>
  {posts.length === 0 && <p>No posts yet.</p>}
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <span class="post-meta">{post.data.pubDate.toLocaleDateString('en-GB')}</span>
        <h2><a href={`/en/blog/${postSlug(post.id)}/`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
      </li>
    ))}
  </ul>
</Base>

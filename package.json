{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "new": "node scripts/new.mjs",
    "lint:md": "markdownlint-cli2 \"src/content/**/*.md\"",
    "format:md": "prettier --write \"src/content/**/*.{md,mdx}\"",
    "format:check": "prettier --check \"src/content/**/*.{md,mdx}\"",
    "spell": "cspell --no-progress",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.8",
    "@astrojs/mdx": "8.1.5",
    "@astrojs/react": "7.1.8",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@tanstack/react-table": "9.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "7.4.11",
    "chart.js": "4.6.1",
    "katex": "0.19.1",
    "react": "^19.3.1",
    "react-chartjs-2": "5.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@cspell/dict-es-es": "3.0.9",
    "cspell": "10.4.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "markdownlint-cli2": "0.24.1",
    "prettier": "3.10.1"
  }
}

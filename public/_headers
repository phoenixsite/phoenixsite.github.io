# Assets con hash de Astro: su nombre cambia si cambia el contenido, así que se pueden cachear un año
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML y resto: siempre revalidar para que los cambios se vean al momento
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # script-src 'unsafe-inline': Astro inserta scripts inline (tema) y Cloudflare puede inyectar otros, así que no se usan hashes.
  # style-src 'unsafe-inline': KaTeX genera atributos style="..."
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=()
